# --- Project A: ecom-listing-orchestrator ---
# Copy to .env and adjust. All values have offline-safe defaults.

# SQLite trace + snapshot database (self-initializing).
LISTING_DB_PATH=ecom_listing.db

# Visual service integration. EMPTY => MockVisualService (offline, writes SVGs).
# Set to e.g. http://127.0.0.1:8012 to call Project B's real service.
LISTING_VISUAL_SERVICE_URL=

# Skip HITL interrupts and auto-approve all gates (true|false).
LISTING_AUTO_APPROVE=false

# Maximum REPLAN attempts before routing to HUMAN_ESCALATION.
LISTING_MAX_REPLAN=2

# Cache dir for MockVisualService generated SVGs.
LISTING_VISUAL_CACHE_DIR=visual_cache

# Default marketplace/platform and forbidden terms (cross-project contract data).
LISTING_PLATFORM=global
LISTING_FORBIDDEN_TERMS=["最","第一","国家级","顶级","第一品牌"]
